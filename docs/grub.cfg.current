set timeout=10
set default=0

menuentry "Ubuntu ARM64 (minimal DT: USB-only)" {
    search --no-floppy --file --set=root /Image.gz
    devicetree /sc8180xp-spx-minimal.dtb
    linux /Image.gz root=PARTUUID=73621fa8-845a-453c-b93e-610e13c4d7a3 rw rootwait \
        earlycon=efifb keep_bootcon console=tty0 \
        module_blacklist=msm fw_devlink=off panic=10 \
        clk_ignore_unused pd_ignore_unused arm64.nopauth efi=noruntime \
        ignore_loglevel
}

menuentry "Ubuntu ARM64 (full DT)" {
    search --no-floppy --file --set=root /Image.gz
    devicetree /sc8180xp-microsoft-surface-pro-x.dtb
    linux /Image.gz root=PARTUUID=73621fa8-845a-453c-b93e-610e13c4d7a3 rw rootwait \
        earlycon=efifb keep_bootcon console=tty0 \
        module_blacklist=msm \
        clk_ignore_unused pd_ignore_unused arm64.nopauth efi=noruntime \
        ignore_loglevel
}

menuentry "Windows Boot Manager" {
    search --no-floppy --file --set=root /EFI/Microsoft/Boot/bootmgfw.efi
    chainloader /EFI/Microsoft/Boot/bootmgfw.efi
}
