# Kernel config fragment for Surface Pro X (SQ2 / sc8180xp)
# Usage: scripts/kconfig/merge_config.sh -m .config configs/surface-pro-x.config
# Base: defconfig (arch/arm64)

# --- ARM64 / firmware interfaces ---
CONFIG_ARM64=y
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_OF=y

# --- Qualcomm SoC core ---
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_PDC=y
CONFIG_PINCTRL_SC8180X=y
CONFIG_SC_GCC_8180X=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SC8180X=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_CLK_RPMH=y

# --- PCIe / NVMe (issue #4) ---
CONFIG_PCI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# --- Wi-Fi / BT (issue #6) ---
CONFIG_ATH11K=m
CONFIG_ATH11K_AHB=m
CONFIG_ATH11K_PCI=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=m
CONFIG_BT_QCA=m

# --- Cellular: X24 LTE via MHI/WWAN (issue #7) ---
CONFIG_MHI_BUS=y
CONFIG_MHI_BUS_PCI_GENERIC=m
CONFIG_WWAN=y
CONFIG_MHI_WWAN_CTRL=m
CONFIG_MHI_WWAN_MBIM=m
CONFIG_QRTR=m
CONFIG_QRTR_MHI=m
CONFIG_QCOM_QMI_HELPERS=m

# --- GPU / Display (issue #5) ---
CONFIG_DRM=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- Input: Type Cover / Surface Aggregator (issue #8) ---
CONFIG_HID=y
CONFIG_HID_MICROSOFT=m
CONFIG_HID_MULTITOUCH=m
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_SURFACE_HID=m
CONFIG_SURFACE_KBD=m

# --- USB ---
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=m

# --- Misc platform ---
CONFIG_QCOM_GENI_SE=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_FASTRPC=m
