# Kernel config fragment for Surface Pro X (SQ2 / sc8180xp)
# Usage: scripts/kconfig/merge_config.sh -m .config configs/surface-pro-x.config
# Base: defconfig (arch/arm64)

# --- ARM64 / firmware interfaces ---
CONFIG_ARM64=y
CONFIG_ACPI=y
CONFIG_EFI=y
CONFIG_OF=y

# --- Qualcomm SoC core ---
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_PDC=y
CONFIG_PINCTRL_SC8180X=y
CONFIG_SC_GCC_8180X=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SC8180X=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_CLK_RPMH=y

# --- PCIe / NVMe (issue #4) ---
CONFIG_PCI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# --- Wi-Fi / BT (issue #6) ---
# WCN3998 is wcn3990-family: ath10k SNOC, NOT ath11k
# (sc8180x.dtsi wifi node compatible = "qcom,wcn3990-wifi")
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m

# --- Cellular: X24 LTE = integrated MPSS (issue #7) ---
# Confirmed on real hardware: modem is the SoC-integrated MPSS
# (ACPI QCOM041E), NOT a discrete PCIe/MHI modem.
CONFIG_QCOM_Q6V5_COMMON=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_PIL_INFO=m
CONFIG_QCOM_SYSMON=m
CONFIG_QCOM_RMTFS_MEM=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QCOM_QMI_HELPERS=m
CONFIG_QCOM_IPA=m
CONFIG_RMNET=m
CONFIG_WWAN=y

# --- GPU / Display (issue #5) ---
CONFIG_DRM=y
CONFIG_DRM_MSM=m
CONFIG_DRM_MSM_GPU_STATE=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- Input: Type Cover / Surface Aggregator (issue #8) ---
CONFIG_HID=y
CONFIG_HID_MICROSOFT=m
CONFIG_HID_MULTITOUCH=m
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_SURFACE_HID=m
CONFIG_SURFACE_KBD=m

# --- USB ---
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
# PHYs MUST be built-in: USB rootfs needs them before modules exist
# (hsphy = qcom,usb-snps-hs-7nm-phy -> SNPS_FEMTO_V2)
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_TYPEC=y
CONFIG_TYPEC_UCSI=m

# --- Watchdog: firmware arms it; kernel must pet it or the device
# powers off minutes into boot (X13s had the same) ---
CONFIG_WATCHDOG=y
CONFIG_QCOM_WDT=y

# --- Bring-up debugging: capture panics to EFI variables, readable
# from Windows after reboot (the display dies before the panic) ---
CONFIG_PSTORE=y
CONFIG_EFI_VARS_PSTORE=y

# --- Misc platform ---
# GENI stack as modules: built-in geni_i2c_probe oopses in ACPI boot
# (NULL deref, verified on device w/ earlycon trace, kernel 7.1-rc7),
# killing init at ~22s. As modules they stay out of the boot path and
# can be loaded (or blacklisted) from the rootfs in DT mode.
CONFIG_QCOM_GENI_SE=m
CONFIG_SERIAL_QCOM_GENI=m
CONFIG_I2C_QCOM_GENI=m
CONFIG_SPI_QCOM_GENI=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QCOM_FASTRPC=m
